# 填任意一个即可；探测顺序：deepseek → anthropic → openai-chat → offline
# 不填任何 key 时自动降级为 offline（用于离线测试 / 无网环境）

# DeepSeek（Anthropic 兼容 tool_use 形状，起步默认）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenAI / 兼容网关
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_CHAT_MODEL=gpt-4o

# 强制指定 provider（可选）：deepseek | anthropic | openai-chat | offline
SOUL_PROVIDER=

# 离线脚本化测试：指向一个 JSON 文件，内容为 ModelTurn 序列（A21）
SOUL_OFFLINE_SCRIPT=

# 状态目录（默认 ~/.soul_buddy）
SOUL_BUDDY_HOME=
