# 填任意一个即可；探测顺序：deepseek → siliconflow → anthropic → openai-chat → offline
# 不填任何 key 时自动降级为 offline（用于离线测试 / 无网环境）

# DeepSeek（Anthropic 兼容 tool_use 形状，起步默认）
DEEPSEEK_API_KEY=
# 官方 model id：deepseek-flash（= DeepSeek-V4.1-Flash，1M 上下文，支持图像理解）
# 或 deepseek-v4-pro（V4-Pro，1M，不支持图像理解）。
# 旧名 deepseek-v4-flash 仍可调用（模型已下线，路由到 V4.1-Flash 计费）；
# deepseek-chat / deepseek-reasoner 已于 2026-07-24 停用。
# 上下文窗口按「模型名」查表（soul_buddy/config.py 的 CONTEXT_WINDOW /
# context_window()），换成表里没有的模型会回落到默认 32k。
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenAI / 兼容网关
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_CHAT_MODEL=gpt-4o

# 硅基流动（SiliconFlow，OpenAI 兼容）：Qwen/Qwen3-8B
# base_url 固定为 https://api.siliconflow.cn/v1，模型名用硅基流动的完整 id。
# 同一个 key 同时可用于 chat 与 embeddings（见下方 EMBEDDING_*）。
# 注意：Qwen3-8B 是纯文本模型，看不了截图。粘贴图片时不会报错，但图片会被
# 降级为一条文本说明（模型名带 VL / Vision / 4V 等标记的才按视觉模型处理）。
# 需要看图请换成视觉模型，例如 Qwen/Qwen2.5-VL-32B-Instruct。
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=Qwen/Qwen3-8B

# 小米 MiMo（OpenAI 兼容）：https://api.xiaomimimo.com/v1
# 只用于 rubric judge 的裁判模型（见下方 SOUL_RUBRIC_JUDGE_PROVIDER）：
# 不在会话 provider 自动探测里，也不出现在 UI 的模型下拉中。
# 注意端点别写成 token-plan-cn.xiaomimimo.com —— 那是另一条产品线的端点，
# 通用 key 在那里会一律 401。
# 未收录在 config.CONTEXT_WINDOW 里的模型名回落到默认 32k 窗口。
XIAOMI_API_KEY=
XIAOMI_BASE_URL=https://api.xiaomimimo.com/v1
XIAOMI_MODEL=mimo-v2.5

# 强制指定 provider（可选）：deepseek | siliconflow | anthropic | openai-chat | xiaomi | offline
SOUL_PROVIDER=

# 离线脚本化测试：指向一个 JSON 文件，内容为 ModelTurn 序列（A21）
SOUL_OFFLINE_SCRIPT=

# 状态目录（默认 ~/.soul_buddy）
SOUL_BUDDY_HOME=

# ── 资料库 / RAG（s18-experts + knowledge）──────────────────────────────
# Embedding：OpenAI 兼容 /embeddings 接口。注意 DeepSeek 没有 embedding 服务，
# 需要单独一个 key。资料库不配置此项时：上传/管理可用，向量化与检索报 503 提示。
#
# 方式一：智谱 embedding-3（推荐，base_url 填到 v4 这一级）
# EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# EMBEDDING_API_KEY=你的智谱key
# EMBEDDING_MODEL=embedding-3
#
# 方式二：硅基流动 BGE-M3（有免费额度）
# EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# EMBEDDING_API_KEY=你的硅基流动key
# EMBEDDING_MODEL=BAAI/bge-m3
#
# 方式三：OpenAI
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=你的openaikey
# EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
# 向量维度；不填则首次调用时从 API 响应自动探测
EMBEDDING_DIMS=

# 向量库：默认 milvus-lite 内嵌（本地文件 ~/.soul_buddy/kb/milvus.db，零部署）。
# 要升级 Milvus standalone 时填 http://localhost:19530 即可，代码零改动。
MILVUS_URI=

# 分块目标 token 数（默认 700）；检索返回条数（默认 5）
KB_CHUNK_TOKENS=
KB_TOP_K=

# ── LangSmith 追踪 ──────────────────────────────────────────────────────
# 开启后所有 LLM 调用（DeepSeek/OpenAI/Anthropic）与 SoulAgent.run 循环
# 都会以嵌套 trace 的形式上报到 LangSmith 控制台。
# 关闭追踪：设 LANGSMITH_TRACING=false 即可，无需改动代码。
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=soul-buddy
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# 控制台地址（用于 App 内「LangSmith」面板的跳转链接）；自托管时改成自己的域名
LANGSMITH_BASE_URL=https://smith.langchain.com

# ── 运行时 rubric 自评闭环（M16 / P6）──────────────────────────────────────
# 全部可配。改完重启 App 生效；显式环境变量优先级高于本文件。
# off      不进验收阶段（默认）
# advisory 评分 + 落盘 + 发事件，但不重修（校准期推荐）
# enforce  不达标会让模型重修（阈值校准好之后再开）
SOUL_RUBRIC_MODE=off
# 质量维度加权总分（0-100）达到该值才算通过
SOUL_RUBRIC_PASS_THRESHOLD=70
# 重修次数硬上限；与 MAX_TURNS 共享预算（INV-17）
SOUL_RUBRIC_MAX_RETRIES=1
# 剩余轮次少于该值就不再重修，避免逼近 MAX_TURNS 时白烧 token
SOUL_RUBRIC_MIN_TURNS_LEFT=3
# Q5（代码质量）/ Q6（沟通表达）是否交给 judge；false 则只按规则评 Q1-Q4。
# 这是总开关，对下面两种 judge 后端都生效（两者都要花 token）
SOUL_RUBRIC_LLM_JUDGE=true
# 送给 judge 的 diff 截断长度（字符）
SOUL_RUBRIC_JUDGE_DIFF_MAX_CHARS=8000
# 单次 provider judge 调用的超时（秒）。judge 阶段是在收尾轮之后跑的，
# 超时前不会发 run_finished，界面就一直显示「Agent 正在运行」（答复文本其实
# 早就流式显示了）。实测：deepseek-chat 2~5 秒，Qwen/Qwen3-8B 41 秒 / 209 秒
# （思考型模型会先产出几百 token 的推理再给 JSON），OpenAI SDK 自身默认还是
# 600 秒超时 + 2 次重试。超时按 INV-20 降级为仅规则层，不会中断整轮。
# 0 = 不限时；用思考型模型做 judge 且不介意等，可调大（如 120）。
SOUL_RUBRIC_JUDGE_TIMEOUT=30
# offline / 无可用 provider 时降级为仅规则层，不报错
SOUL_RUBRIC_DEGRADE_ON_NO_PROVIDER=true
# Judge provider：Q5/Q6 固定由哪个模型打分。
#   xiaomi  = 默认，用小米 MiMo（需 XIAOMI_API_KEY；未配置时自动回落到会话 provider）
#   session = 跟随会话模型（旧行为）
# 固定裁判后，切换会话模型只改变"被评对象"，不同模型的报告才可比；
# 报告里的 judge_model 字段记录实际打分模型，dashboard 按被测模型分组展示。
SOUL_RUBRIC_JUDGE_PROVIDER=xiaomi
# 单次 judge 的输出预算：judge 会显式关掉思考模型的推理（xiaomi 走
# chat_template_kwargs.enable_thinking=false，实测 44s -> 1.5s），正常几十个
# token 就够。这里是兜底，防止某个模型不认这个参数时把预算烧在
# reasoning_content 上、content 为空导致 Q5/Q6 静默降级。
SOUL_RUBRIC_JUDGE_MAX_TOKENS=3000

# ── Judge 后端（Q5/Q6 的两种测法）──────────────────────────────────────────
# llm      默认：让 provider 输出 {"scores":[...]}，严格解析
# typesafe 走 api.typesafe.ai，拿锚点级别上的概率分布 + confidence；
#          分数从「抠出来的整数」变成概率加权位置，低置信可判为不适用
SOUL_RUBRIC_JUDGE_BACKEND=llm
# TypeSafe 的 key。只从环境读，不落盘、不进报告、不回传前端
TYPESAFE_API_KEY=
# TypeSafe 的判定模型
SOUL_RUBRIC_TYPESAFE_MODEL=jev-latest
# 单次判定的超时（秒）
SOUL_RUBRIC_TYPESAFE_TIMEOUT=30
# 低于该置信度的判定标为「不适用」，不参与加权。
# 这是兜底而非质量闸门：实测干净材料 0.85~0.94、刻意模糊材料仍有 0.55~0.72，
# 所以 0.5 只在分布彻底塌掉时才触发。想按材料质量分流得往 0.8 抬（会丢判定）
SOUL_RUBRIC_TYPESAFE_MIN_CONFIDENCE=0.5
# TypeSafe 不可达时回退到 provider judge，而不是直接丢掉 Q5/Q6（INV-20）
SOUL_RUBRIC_TYPESAFE_FALLBACK_TO_LLM=true
