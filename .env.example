# 填任意一个即可；探测顺序：deepseek → anthropic → openai-chat → offline
# 不填任何 key 时自动降级为 offline（用于离线测试 / 无网环境）

# DeepSeek（Anthropic 兼容 tool_use 形状，起步默认）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenAI / 兼容网关
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_CHAT_MODEL=gpt-4o

# 强制指定 provider（可选）：deepseek | anthropic | openai-chat | offline
SOUL_PROVIDER=

# 离线脚本化测试：指向一个 JSON 文件，内容为 ModelTurn 序列（A21）
SOUL_OFFLINE_SCRIPT=

# 状态目录（默认 ~/.soul_buddy）
SOUL_BUDDY_HOME=

# ── 资料库 / RAG（s18-experts + knowledge）──────────────────────────────
# Embedding：OpenAI 兼容 /embeddings 接口。注意 DeepSeek 没有 embedding 服务，
# 需要单独一个 key。资料库不配置此项时：上传/管理可用，向量化与检索报 503 提示。
#
# 方式一：智谱 embedding-3（推荐，base_url 填到 v4 这一级）
# EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# EMBEDDING_API_KEY=你的智谱key
# EMBEDDING_MODEL=embedding-3
#
# 方式二：硅基流动 BGE-M3（有免费额度）
# EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# EMBEDDING_API_KEY=你的硅基流动key
# EMBEDDING_MODEL=BAAI/bge-m3
#
# 方式三：OpenAI
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=你的openaikey
# EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
# 向量维度；不填则首次调用时从 API 响应自动探测
EMBEDDING_DIMS=

# 向量库：默认 milvus-lite 内嵌（本地文件 ~/.soul_buddy/kb/milvus.db，零部署）。
# 要升级 Milvus standalone 时填 http://localhost:19530 即可，代码零改动。
MILVUS_URI=

# 分块目标 token 数（默认 700）；检索返回条数（默认 5）
KB_CHUNK_TOKENS=
KB_TOP_K=

# ── LangSmith 追踪 ──────────────────────────────────────────────────────
# 开启后所有 LLM 调用（DeepSeek/OpenAI/Anthropic）与 SoulAgent.run 循环
# 都会以嵌套 trace 的形式上报到 LangSmith 控制台。
# 关闭追踪：设 LANGSMITH_TRACING=false 即可，无需改动代码。
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=soul-buddy
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
