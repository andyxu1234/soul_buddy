# 填任意一个即可；探测顺序：deepseek → anthropic → openai-chat → offline
# 不填任何 key 时自动降级为 offline（用于离线测试 / 无网环境）

# DeepSeek（Anthropic 兼容 tool_use 形状，起步默认）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenAI / 兼容网关
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_CHAT_MODEL=gpt-4o

# 强制指定 provider（可选）：deepseek | anthropic | openai-chat | offline
SOUL_PROVIDER=

# 离线脚本化测试：指向一个 JSON 文件，内容为 ModelTurn 序列（A21）
SOUL_OFFLINE_SCRIPT=

# 状态目录（默认 ~/.soul_buddy）
SOUL_BUDDY_HOME=

# ── 资料库 / RAG（s18-experts + knowledge）──────────────────────────────
# Embedding：OpenAI 兼容 /embeddings 接口。注意 DeepSeek 没有 embedding 服务，
# 需要单独一个 key。资料库不配置此项时：上传/管理可用，向量化与检索报 503 提示。
#
# 方式一：智谱 embedding-3（推荐，base_url 填到 v4 这一级）
# EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# EMBEDDING_API_KEY=你的智谱key
# EMBEDDING_MODEL=embedding-3
#
# 方式二：硅基流动 BGE-M3（有免费额度）
# EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# EMBEDDING_API_KEY=你的硅基流动key
# EMBEDDING_MODEL=BAAI/bge-m3
#
# 方式三：OpenAI
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=你的openaikey
# EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
# 向量维度；不填则首次调用时从 API 响应自动探测
EMBEDDING_DIMS=

# 向量库：默认 milvus-lite 内嵌（本地文件 ~/.soul_buddy/kb/milvus.db，零部署）。
# 要升级 Milvus standalone 时填 http://localhost:19530 即可，代码零改动。
MILVUS_URI=

# 分块目标 token 数（默认 700）；检索返回条数（默认 5）
KB_CHUNK_TOKENS=
KB_TOP_K=

# ── LangSmith 追踪 ──────────────────────────────────────────────────────
# 开启后所有 LLM 调用（DeepSeek/OpenAI/Anthropic）与 SoulAgent.run 循环
# 都会以嵌套 trace 的形式上报到 LangSmith 控制台。
# 关闭追踪：设 LANGSMITH_TRACING=false 即可，无需改动代码。
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=soul-buddy
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# 控制台地址（用于 App 内「LangSmith」面板的跳转链接）；自托管时改成自己的域名
LANGSMITH_BASE_URL=https://smith.langchain.com

# ── 运行时 rubric 自评闭环（M16 / P6）──────────────────────────────────────
# 七项全部可配。改完重启 App 生效；显式环境变量优先级高于本文件。
# off      不进验收阶段（默认）
# advisory 评分 + 落盘 + 发事件，但不重修（校准期推荐）
# enforce  不达标会让模型重修（阈值校准好之后再开）
SOUL_RUBRIC_MODE=off
# 质量维度加权总分（0-100）达到该值才算通过
SOUL_RUBRIC_PASS_THRESHOLD=70
# 重修次数硬上限；与 MAX_TURNS 共享预算（INV-17）
SOUL_RUBRIC_MAX_RETRIES=1
# 剩余轮次少于该值就不再重修，避免逼近 MAX_TURNS 时白烧 token
SOUL_RUBRIC_MIN_TURNS_LEFT=3
# Q5（代码质量）/ Q6（沟通表达）是否交给 LLM judge；false 则只按规则评 Q1-Q4
SOUL_RUBRIC_LLM_JUDGE=true
# 送给 judge 的 diff 截断长度（字符）
SOUL_RUBRIC_JUDGE_DIFF_MAX_CHARS=8000
# offline / 无可用 provider 时降级为仅规则层，不报错
SOUL_RUBRIC_DEGRADE_ON_NO_PROVIDER=true
